# Copy to .env.local for local dev. These are PUBLIC client identifiers, not secrets
# (TAD §0.8) — safe to compile into the client bundle. Real values come from an Entra
# app registration, which is an external, non-repo step (an IT-admin/Azure-portal task,
# not something this codebase can generate) — ask the CMO/IT admin for these.

VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_MSAL_REDIRECT_URI=http://localhost:5173
VITE_ALLOWED_EMAILS=
